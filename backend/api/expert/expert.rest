###
# BULK UPLOAD EXPERTS (Excel file)
POST {{baseURL}}/bulk-upload
authorization: {{auth_JWT}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="experts.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./experts.xlsx
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###
# GET ALL EXPERTS
GET {{baseURL}}

###
# GET EXPERT BY ID
GET {{baseURL}}/1

###
# UPDATE EXPERT BY ID
PATCH {{baseURL}}/3
authorization: {{auth_JWT}}
Content-Type: application/json

{
    "name": "John Doe Updated",
    "desc": "Updated description for the expert",
    "photoURL": "https://s3.amazonaws.com/your-bucket/expert1-updated.jpg"
}

###
# DELETE EXPERT BY ID (Soft delete - sets isActive to false)
DELETE {{baseURL}}/1
authorization: {{auth_JWT}}

###
# ENABLE EXPERT BY ID
PATCH {{baseURL}}/3/enable
authorization: {{auth_JWT}}

###
# GET EXPERT SESSIONS WITH COUNTS
GET {{baseURL}}/3/sessions

###
# GET EXPERT STATISTICS (SESSIONS & COMMUNITIES COUNT)
GET {{baseURL}}/3/stats

###
# GET EXPERT COMMUNITIES WITH COUNTS
GET {{baseURL}}/3/community
authorization: {{auth_JWT}}

###
# SEARCH EXPERTS BY TAG
GET {{baseURL}}/search?tag=software

###
# ADD EXPERT TO COMMUNITY (Subscription)
POST {{baseURL}}/3/subscription
Content-Type: application/json

{
    "expertId": 3,
    "communityId": 4,
    "amount": 500,
    "paymentId": "pay_123456789",
    "transactionId": "txn_123456789",
    "expiresAt": "2024-12-31T23:59:59.000Z",
    "category": "monthly"
}

