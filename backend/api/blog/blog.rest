### CREATE A PRIVATE BLOG AND PUBLISH
POST {{baseURL}}
Content-Type: application/json

{
    "title":"Figuring Out-Community",
    "content":"<p>This is podcast turned blog, called figuring out</p>",
    "draft":false,
    "unifiedUserId":3,
    "isPrivate":true,
    "communityId":1,
    "tagsData":[
        {
            "name":"community-blog"
        },
        {
            "id":7,
            "name":"new-one"
        }
    ]

}


