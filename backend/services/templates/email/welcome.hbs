{{#> base}}
{{#*inline "content"}}
    <h2 style="margin-top:0; margin-bottom:12px; font-size: 1.5em; color: #007bff;">
        Welcome to IFCA - Indian Federation of Culinary Associations
    </h2>
    <p style="margin-bottom: 18px;">Dear {{recipientName}},</p>
    
    <p style="margin-bottom: 18px;">Welcome to IFCA! We're excited to have you join our community of culinary professionals.</p>
    
    <div class="alert-success" style="margin-bottom: 18px;">
        <h3 style="margin-top:0; margin-bottom: 8px; color: #155724;">Getting Started with IFCA</h3>
        <ul style="margin:0 0 0 18px; padding:0;">
            <li>Complete your profile to showcase your expertise</li>
            <li>Connect with other culinary professionals</li>
            <li>Explore upcoming events and workshops</li>
            <li>Join relevant culinary communities</li>
        </ul>
    </div>

    <div style="margin-bottom: 18px;">
        <p style="margin:0;"><strong>Your email id:</strong> {{email}}</p>
        <p style="margin:0;"><strong>Your password:</strong> {{password}}</p>
    </div>

    <div style="margin-bottom: 18px;">
        <p style="margin:0;"><strong>Learn Platform Credentials</strong></p>
        
        <p style="margin:0;">Your username is: {{username}}</p>
        <p style="margin:0;">Your password is: {{password}}</p>
    </div>

    <div style="margin-bottom: 24px;">
        <p style="margin-bottom: 8px;">Please use the following link to complete your profile:</p>
        <a href="{{actionUrl}}" class="button" style="display:inline-block; padding:12px 28px; background-color:#007bff; color:#fff !important; text-decoration:none; border-radius:5px; font-weight:bold; font-size:16px;">
            Complete Your Profile
        </a>
    </div>

    <div class="metadata" style="background-color:#f8f9fa; padding:12px; border-radius:5px; margin:16px 0;">
        <p style="margin:0 0 6px 0;"><strong>Need Help?</strong></p>
        <p style="margin:0;">Contact IFCA support at:</p>
        <p style="margin:0;">Email: <a href="mailto:contact.pvlifcaindia@gmail.com" style="color:#007bff;">contact.pvlifcaindia@gmail.com</a></p>
        <p style="margin:0;">Phone: +91 00000 00000</p>
    </div>

    <p style="margin-top: 24px;">Best regards,<br>
    The IFCA Team</p>
{{/inline}}
{{/base}} 