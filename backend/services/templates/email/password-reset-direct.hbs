{{#> base}}
  {{#*inline "content"}}
    <h2 style="margin-top:0; margin-bottom:12px; font-size: 1.5em; color: #007bff;">Your IFCA Password Has Been Reset</h2>
    <p style="margin-bottom: 18px;">Dear {{recipientName}},</p>
    <p style="margin-bottom: 18px;">We received a request to reset your IFCA account password. Your password has been successfully reset.</p>
    
    <div style="margin-bottom: 24px; padding: 16px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 5px;">
      <h3 style="margin-top:0; margin-bottom: 12px; color: #495057;">Your New Password</h3>
      <p style="margin-bottom: 8px;"><strong>New Password:</strong> <span style="font-family: monospace; background-color: #e9ecef; padding: 4px 8px; border-radius: 3px;">{{newPassword}}</span></p>
      <p style="margin-bottom: 0; font-size: 14px; color: #6c757d;">Please change this password after logging in for security purposes.</p>
    </div>
    
    <div style="margin-bottom: 24px;">
      <a href="{{actionUrl}}" class="button" style="display:inline-block; padding:12px 28px; background-color:#007bff; color:#fff !important; text-decoration:none; border-radius:5px; font-weight:bold; font-size:16px;">Login to IFCA</a>
    </div>
    
    <div style="margin-top: 24px; padding: 16px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 5px;">
      <h4 style="margin-top:0; margin-bottom: 8px; color: #856404;">Security Notice</h4>
      <p style="margin-bottom: 0; font-size: 14px; color: #856404;">If you did not request this password reset, please contact IFCA support immediately at contact.pvlifcaindia@gmail.com</p>
    </div>
    
    <p style="margin-top: 24px;">Best regards,<br>The IFCA Team</p>
  {{/inline}}
{{/base}} 