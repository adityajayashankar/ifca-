{{#> base}}
  {{#*inline "content"}}
    <h2 style="margin-top:0; margin-bottom:12px; font-size: 1.5em; color: #007bff;">Your IFCA Password Was Changed</h2>
    <p style="margin-bottom: 18px;">Dear {{recipientName}},</p>
    <p style="margin-bottom: 18px;">This is a confirmation that your IFCA account password was successfully changed. If you performed this action, you can safely ignore this email.</p>
    
    <div style="margin-bottom: 24px; padding: 16px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 5px;">
      <h3 style="margin-top:0; margin-bottom: 12px; color: #495057;">Account Security</h3>
      <ul style="margin-bottom: 0; padding-left: 20px; color: #495057;">
        <li style="margin-bottom: 8px;">Your password was changed on: <strong>{{changeDate}}</strong></li>
        <li style="margin-bottom: 8px;">If this was you, no further action is required</li>
        <li style="margin-bottom: 0;">Your account is now secured with the new password</li>
      </ul>
    </div>
    
    <div style="margin-top: 24px; padding: 16px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 5px;">
      <h4 style="margin-top:0; margin-bottom: 8px; color: #856404;">Security Alert</h4>
      <p style="margin-bottom: 0; font-size: 14px; color: #856404;">If you did not perform this password change, please contact IFCA support immediately at contact.pvlifcaindia@gmail.com or reset your password using the "Forgot Password" option.</p>
    </div>
    
    <p style="margin-top: 24px;">Best regards,<br>The IFCA Team</p>
  {{/inline}}
{{/base}} 