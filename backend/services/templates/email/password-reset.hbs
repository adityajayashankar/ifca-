{{#> base}}
  <h2 style="margin-top:0; margin-bottom:12px; font-size: 1.5em; color: #007bff;">Reset Your IFCA Password</h2>
  <p style="margin-bottom: 18px;">Dear {{recipientName}},</p>
  <p style="margin-bottom: 18px;">We received a request to reset your IFCA account password. Click the button below to create a new password:</p>
  
  <div style="margin-bottom: 24px;">
    <a href="{{resetUrl}}" class="button" style="display:inline-block; padding:12px 28px; background-color:#007bff; color:#fff !important; text-decoration:none; border-radius:5px; font-weight:bold; font-size:16px;">Reset Password</a>
  </div>
  
  <div style="margin-bottom: 24px; padding: 16px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 5px;">
    <h3 style="margin-top:0; margin-bottom: 12px; color: #495057;">Important Information</h3>
    <ul style="margin-bottom: 0; padding-left: 20px; color: #495057;">
      <li style="margin-bottom: 8px;">This link will expire in 1 hour for security reasons</li>
      <li style="margin-bottom: 8px;">If you don't see the button, copy and paste this link: <span style="font-family: monospace; background-color: #e9ecef; padding: 2px 6px; border-radius: 3px;">{{resetUrl}}</span></li>
      <li style="margin-bottom: 0;">You can only use this link once</li>
    </ul>
  </div>
  
  <div style="margin-top: 24px; padding: 16px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 5px;">
    <h4 style="margin-top:0; margin-bottom: 8px; color: #856404;">Security Notice</h4>
    <p style="margin-bottom: 0; font-size: 14px; color: #856404;">If you did not request this password reset, please ignore this email or contact IFCA support immediately at contact.pvlifcaindia@gmail.com</p>
  </div>
  
  <p style="margin-top: 24px;">Best regards,<br>The IFCA Team</p>
{{/base}} 