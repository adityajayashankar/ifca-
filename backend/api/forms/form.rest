@baseUrl = http://localhost:5000/api/v1
@authToken = Bearer your_jwt_token_here
@adminToken = Bearer your_admin_jwt_token_here

# ========================================
# FORM MANAGEMENT ENDPOINTS (Admin Only)
# ========================================

### Create a new form (Admin Only)
POST {{baseUrl}}/forms
Content-Type: application/json
Authorization: {{adminToken}}

{
  "formName": "Event RSVP Form",
  "creatorId": 1,
  "questions": [
    {
      "question": "What is your name?",
      "answerType": "text",
      "description": "Enter your full name",
      "isRequired": true,
      "options": []
    },
    {
      "question": "Will you attend the event?",
      "answerType": "radio",
      "description": "Please select your attendance",
      "isRequired": true,
      "options": ["Yes", "No", "Maybe"]
    },
    {
      "question": "Dietary preferences",
      "answerType": "checkbox",
      "description": "Select all that apply",
      "isRequired": false,
      "options": ["Vegetarian", "Vegan", "Gluten-free", "Dairy-free", "No restrictions"]
    }
  ],
  "isGlobal": false,
  "communityIds": [1, 2]
}

### Edit a form (Admin Only)
PUT {{baseUrl}}/forms/1
Content-Type: application/json
Authorization: {{adminToken}}

{
  "formName": "Updated Event RSVP Form",
  "adminId": 1,
  "formLink": "https://forms.gle/updated-form-link",
  "formImg": "https://example.com/updated-image.jpg",
  "formDesc": "This is an updated event RSVP form"
}

### Delete a form (Admin Only)
DELETE {{baseUrl}}/forms/1
Authorization: {{adminToken}}

### Update form by creator (Admin Only)
PUT {{baseUrl}}/forms/1/update
Content-Type: application/json
Authorization: {{adminToken}}

{
  "formName": "Updated Form Name",
  "formFields": {
    "description": "Updated form description",
    "settings": {
      "allowMultipleResponses": false,
      "requireAuthentication": true
    }
  }
}

# ========================================
# FORM RETRIEVAL ENDPOINTS (Optimized)
# ========================================

### Get form by ID
GET {{baseUrl}}/forms/1

### Get all forms (with pagination and search)
GET {{baseUrl}}/forms?page=1&limit=10&search=event&creatorId=1&isGlobal=false&sortBy=createdAt&sortOrder=desc

### Get all forms (with pagination and search)
GET {{baseUrl}}/forms

### Get forms by user ID (with pagination)
GET {{baseUrl}}/forms/user/3?page=1&limit=10

### Get forms by community ID (with pagination)
GET {{baseUrl}}/forms/community/1?page=1&limit=10

### Get all users (with pagination and search)
GET {{baseUrl}}/forms/users?page=1&limit=20&search=john
Authorization: {{adminToken}}

# ========================================
# FORM RESPONSE ENDPOINTS
# ========================================

### Submit form response (Authenticated)
POST {{baseUrl}}/forms/1/submit
Content-Type: application/json
Authorization: {{authToken}}

{
  "responses": {
    "1": "John Doe",
    "2": "Yes",
    "3": ["Vegetarian", "Gluten-free"]
  },
  "communityId": 1
}

### Get user's form response status (Authenticated)
GET {{baseUrl}}/forms/user-response-status?formId=38&communityId=131
Authorization: {{authToken}}

### Get form responses for specific user
GET {{baseUrl}}/forms/form/form-responses?formId=39&userId=38&communityId=131

### Get form responses by creator ID (with pagination)
GET {{baseUrl}}/forms/responses/1?page=1&limit=10
Authorization: {{adminToken}}

### Get questions by creator ID (with pagination)
GET {{baseUrl}}/forms/questions/1?page=1&limit=10
Authorization: {{adminToken}}

### Get form responses by form ID (with pagination)
GET {{baseUrl}}/forms/responseByFormId/1?page=1&limit=10
Authorization: {{adminToken}}

# ========================================
# GOOGLE INTEGRATION ENDPOINTS (Commented)
# ========================================

### Fetch Google Form responses (Commented)
# GET {{baseUrl}}/forms/form-responses?formId=google_form_id_here

### Fetch Google Sheets data (Commented)
# GET {{baseUrl}}/forms/sheet-data?spreadsheetId=your_spreadsheet_id&range=Sheet1!A1:Z1000

### Google OAuth authorization (Commented)
# GET {{baseUrl}}/forms/authorize

### Google OAuth callback (Commented)
# GET {{baseUrl}}/forms/oauth2callback?code=authorization_code_here

