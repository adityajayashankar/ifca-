enum HuddleFrequency {
  DAILY
  WEEKLY
  FORTNIGHTLY
}

enum AudienceType {
  ALL_MEMBERS
  SELECTED_MEMBERS
}

enum LocationType {
  DIGITAL
  OFFLINE
}

enum LeaderSelectionType {
  USER
  RANDOM
  FIRST_LOGIN
  ROUNDROBIN
}

enum HuddleActivityType {
  AI_SLIDESHOW
  AI_VIDEO_MESSAGE
  DISCUSSION_TOPIC
  QUIZ
  DEBATE
  CONTEST
  VOTING_SURVEY
  REFLECTION
  GUIDED_SESSION
  STORY_SPOTLIGHT
  ANNOUNCEMENT
}

model Huddle {
  id                  Int                 @id @default(autoincrement())
  title               String
  description         String?
  communityId         Int
  creatorId           Int
  frequency           HuddleFrequency
  scheduledTime       DateTime
  timezone            String              @default("UTC")
  selectedActivities  String[]
  audienceType        AudienceType        @default(ALL_MEMBERS)
  selectedMemberIds   Int[]               @default([])
  locationType        LocationType        @default(DIGITAL)
  offlineLocation     String?
  roomId              String?             @unique
  leaderId            Int?
  leaderSelectionType LeaderSelectionType @default(USER)
  isLive              Boolean             @default(false)
  isScheduled         Boolean             @default(true)
  startTime           DateTime?
  endTime             DateTime?
  currentActivityIndex Int?                @default(0)
  notificationSent    Json?
  aiHook              String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  community           Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator             unifiedUser                @relation("HuddleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  leader              unifiedUser?               @relation("HuddleLeader", fields: [leaderId], references: [id])
  activities          HuddleActivity[]
  attendances         HuddleAttendance[]
  summaries           HuddleSummary[]
  notifications       Notification[]
  invitations         HuddleInvitation[]
  activityCompletions HuddleActivityCompletion[]
}

model HuddleActivity {
  id           Int                @id @default(autoincrement())
  huddleId     Int
  activityType HuddleActivityType
  activityData Json?
  linkUrl      String?
  postId       Int?
  pollId       Int?
  threadId     Int?
  formId       Int?
  sessionId    Int?
  resourceId   Int?
  isGenerated  Boolean            @default(false)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  huddle      Huddle                     @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  post        Post?                      @relation("HuddleActivityPost", fields: [postId], references: [id])
  poll        Post?                      @relation("HuddleActivityPoll", fields: [pollId], references: [id])
  thread      Thread?                    @relation(fields: [threadId], references: [id])
  form        Form?                      @relation(fields: [formId], references: [id])
  session     Session?                   @relation("HuddleActivitySession", fields: [sessionId], references: [id])
  resource    Resource?                  @relation(fields: [resourceId], references: [id])
  completions HuddleActivityCompletion[]
}

model HuddleAttendance {
  id           Int       @id @default(autoincrement())
  huddleId     Int
  userId       Int
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?
  pointsEarned Int       @default(0)

  huddle Huddle      @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  user   unifiedUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([huddleId, userId])
}

model HuddleSummary {
  id          Int      @id @default(autoincrement())
  huddleId    Int
  summaryText String
  highlights  String[]
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())

  huddle Huddle @relation(fields: [huddleId], references: [id], onDelete: Cascade)
}

model HuddleActivityCompletion {
  id          Int      @id @default(autoincrement())
  huddleId    Int
  activityId  Int
  userId      Int
  completedAt DateTime @default(now())

  huddle   Huddle         @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  activity HuddleActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     unifiedUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([huddleId, activityId, userId])
}

model HuddleStreak {
  id             Int       @id @default(autoincrement())
  userId         Int
  communityId    Int
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastHuddleDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      unifiedUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model HuddleInvitation {
  id          Int              @id @default(autoincrement())
  huddleId    Int
  userId      Int
  status      InvitationStatus @default(PENDING)
  invitedAt   DateTime         @default(now())
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  huddle Huddle      @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  user   unifiedUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([huddleId, userId])
}
