### Huddle API Endpoints
### Base URL
@baseUrl = http://localhost:5000/api/v1/huddle

### Variables
@communityId = 1
@userId = 2
@huddleId = 3

# ==================== HUDDLE CRUD ====================

### Create a new huddle
POST {{baseUrl}}/create
Content-Type: application/json

{
    "title": "Weekly Team Standup",
    "description": "Weekly huddle for team sync and updates",
    "communityId": {{communityId}},
    "creatorId": {{userId}},
    "frequency": "WEEKLY",
    "scheduledTime": "2025-12-20T10:00:00.000Z",
    "timezone": "Asia/Kolkata",
    "selectedActivities": ["DISCUSSION_TOPIC", "VOTING_SURVEY", "ANNOUNCEMENT"],
    "audienceType": "ALL_MEMBERS",
    "selectedMemberIds": [],
    "locationType": "DIGITAL",
    "offlineLocation": null,
    "leaderId": {{userId}},
    "leaderSelectionType": "USER"
}

###

### Create huddle with AI activities
POST {{baseUrl}}/create
Content-Type: application/json

{
    "title": "Innovation Showcase",
    "description": "Monthly huddle featuring AI-generated content",
    "communityId": {{communityId}},
    "creatorId": {{userId}},
    "frequency": "FORTNIGHTLY",
    "scheduledTime": "2025-12-25T14:00:00.000Z",
    "timezone": "UTC",
    "selectedActivities": ["AI_SLIDESHOW", "AI_VIDEO_MESSAGE", "QUIZ", "REFLECTION"],
    "audienceType": "ALL_MEMBERS",
    "locationType": "DIGITAL",
    "leaderSelectionType": "RANDOM"
}

###

### Create huddle for selected members only
POST {{baseUrl}}/create
Content-Type: application/json

{
    "title": "Leadership Circle",
    "description": "Exclusive huddle for selected team leads",
    "communityId": {{communityId}},
    "creatorId": {{userId}},
    "frequency": "WEEKLY",
    "scheduledTime": "2025-12-22T09:00:00.000Z",
    "timezone": "UTC",
    "selectedActivities": ["DISCUSSION_TOPIC", "DEBATE", "STORY_SPOTLIGHT"],
    "audienceType": "SELECTED_MEMBERS",
    "selectedMemberIds": [1, 2, 3],
    "locationType": "OFFLINE",
    "offlineLocation": "Conference Room A",
    "leaderSelectionType": "ROUNDROBIN"
}

###

### Get huddle by ID
GET {{baseUrl}}/{{huddleId}}

###

### Update huddle
PUT {{baseUrl}}/{{huddleId}}
Content-Type: application/json

{
    "title": "Updated Weekly Standup",
    "description": "Updated description for the huddle",
    "scheduledTime": "2025-12-21T11:00:00.000Z"
}

###

### Delete huddle
DELETE {{baseUrl}}/{{huddleId}}

###

# ==================== HUDDLE EXECUTION ====================

### Launch/Start a huddle
POST {{baseUrl}}/{{huddleId}}/launch
Content-Type: application/json

{
    "userId": {{userId}}
}

###

### End a huddle
POST {{baseUrl}}/{{huddleId}}/end
Content-Type: application/json

{}

###

### Join a huddle
POST {{baseUrl}}/{{huddleId}}/join
Content-Type: application/json

{
    "userId": {{userId}}
}

###

### Leave a huddle
POST {{baseUrl}}/{{huddleId}}/leave
Content-Type: application/json

{
    "userId": {{userId}}
}

###

### Get huddle attendees
GET {{baseUrl}}/{{huddleId}}/attendees

###

### Get huddle activities
GET {{baseUrl}}/{{huddleId}}/activities

###

# ==================== HUDDLE MANAGEMENT ====================

### Get all huddles for a community
GET {{baseUrl}}/community/{{communityId}}

###

### Get upcoming huddles for a community
GET {{baseUrl}}/community/{{communityId}}?status=upcoming

###

### Get live huddles for a community
GET {{baseUrl}}/community/{{communityId}}?status=live

###

### Get completed huddles for a community
GET {{baseUrl}}/community/{{communityId}}?status=completed

###

### Get user's upcoming huddles
GET {{baseUrl}}/user/{{userId}}/upcoming

###

### Generate AI summary for huddle
POST {{baseUrl}}/{{huddleId}}/generate-summary
Content-Type: application/json

{}

###

# ==================== ENGAGEMENT & ANALYTICS ====================

### Get huddle statistics
GET {{baseUrl}}/{{huddleId}}/stats

###

### Get community huddle leaderboard
GET {{baseUrl}}/community/{{communityId}}/leaderboard

###

### Get community huddle leaderboard with limit
GET {{baseUrl}}/community/{{communityId}}/leaderboard?limit=5

###

### Get user's huddle streaks
GET {{baseUrl}}/user/{{userId}}/streaks

###

