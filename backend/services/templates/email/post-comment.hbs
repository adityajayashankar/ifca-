{{#> base}}
  <div class="content">
    <h1>New Comment on Your Post</h1>
    
    <p>Hello {{recipientName}},</p>
    
    <p>Someone commented on your post "{{postTitle}}".</p>
    
    {{#if commenterName}}
      <p><strong>{{commenterName}}</strong> commented: "{{commentContent}}"</p>
    {{/if}}
    
    <div class="action-button">
      <a href="{{actionUrl}}" class="btn">View Comment</a>
    </div>
    
    <p>If you have any questions, feel free to reach out to our support team.</p>
    
    <p>Best regards,<br>The IFCA Team</p>
  </div>
{{/base}} 