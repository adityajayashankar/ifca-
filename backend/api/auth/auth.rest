@baseURL=http://localhost:5000/api/v1/auth
@prodURL=https://pvl.ifcaindia.com/api/api/v1/auth

@devURL = https://dev.ifcaindia.com/api/api/v1/auth 

@contentType = application/json

### Signup Example
POST {{baseURL}}/signup
Content-Type: {{contentType}}

{
  "email": "user140@example.com",
  "password": "Abcd@123",
  "name": "Rahul Sharma",
  "phone": "9876543112",
  "location": "Bangalore",
  "pincode": "560004",
  "userType": "user"
}

### Login Example (no userType, triggers role selection if multiple roles)
POST {{baseURL}}/signin
Content-Type: {{contentType}}

{
  "email": "anil@",
  "password": "Abcd@123"
}

### Login Example (with userType, for users with multiple roles)
POST {{baseURL}}/signin
Content-Type: {{contentType}}
{
  "email": "user1@example.com",
  "password": "Abcd@123",
  "userType": "user"
}

### Login Example (with userType, for admin)
POST {{baseURL}}/signin
Content-Type: {{contentType}}
{
  "email": "admin@cp.in",
  "password": "Abcd@123",
  "userType": "admin"
}

